<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="schedule"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_schedule"
        android:shortcutShortLabel="@string/shortcut_schedule">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.stellar.simulcast"
            android:targetClass="com.stellar.simulcast.MainActivity">
            <extra android:name="shortcut" android:value="schedule" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="continue"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_read"
        android:shortcutShortLabel="@string/shortcut_continue">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.stellar.simulcast"
            android:targetClass="com.stellar.simulcast.MainActivity">
            <extra android:name="shortcut" android:value="continue" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.stellar.simulcast"
            android:targetClass="com.stellar.simulcast.MainActivity">
            <extra android:name="shortcut" android:value="search" />
        </intent>
    </shortcut>
</shortcuts>
